{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://static.boppa.app/schema/context.v1.schema.json",
  "title": "Boppa media source context page",
  "description": "context/<key>/config.json. The key is the folder name; its scripts are context/<key>/*.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "url", "intervalSeconds"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "intervalSeconds": { "type": "integer", "minimum": 1 },
    "customUserAgent": { "type": "string" }
  }
}
